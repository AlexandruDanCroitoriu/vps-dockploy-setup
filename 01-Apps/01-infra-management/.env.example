# Default service credentials and Infra Management login credentials.
# The username must be an email address and also becomes the initial Dockploy
# administrator email. The password is also used for root SSH provisioning.
INFRA_SERVICES_DEFAULT_USERNAME=admin@example.com
INFRA_SERVICES_DEFAULT_PASSWORD=replace-with-a-strong-password

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret

# Public URL of this application. Use http://localhost:3000 for local development
# and the external HTTPS address when deployed through Dokploy.
NEXTAUTH_URL=http://localhost:3000

# Server-only token used to list domains on the Cloudflare page.
# Grant the token Zone:Read and DNS:Write permissions for the zones it should manage.
CLOUDFLARE_API_TOKEN=replace-with-a-cloudflare-api-token

# Server-only Resend key with full access. Infra Management uses it to create and
# verify instance domains, then gives Vendure a separate domain-scoped sending key.
RESEND_API_KEY=replace-with-a-full-access-resend-api-key

# Project builds are enabled automatically for generated Infra Management
# deployments. Manual production deployments can opt in with these values and
# must also mount /var/run/docker.sock into the application container.
# PROJECT_BUILDS_ENABLED=true
# PROJECT_REPOSITORY_URL=https://github.com/AlexandruDanCroitoriu/vps-dockploy-setup.git
# PROJECT_REPOSITORY_BRANCH=main
# PROJECT_REPOSITORY_PATH=/app/data/repository

# Optional one-time migration for an existing deployment. When the database is
# empty, these values are imported as a configured instance. Remove them after
# confirming the import. The instance must still be selected in the dashboard.
# DOKPLOY_NAME=Production
# DOKPLOY_URL=https://dokploy.example.com
# DOKPLOY_API_KEY=your-generated-api-key
