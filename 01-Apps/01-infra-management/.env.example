# The username entered on the login page.
ADMIN_USERNAME=admin

# Generate an escaped bcrypt hash for a Next.js .env file:
# node -e 'console.log(require("bcryptjs").hashSync("replace-with-a-strong-password", 12).replaceAll("$", "\\$"))'
ADMIN_PASSWORD_HASH=replace-with-the-generated-bcrypt-hash

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret

# Public URL of this application. Use http://localhost:3000 for local development
# and the external HTTPS address when deployed through Dokploy.
NEXTAUTH_URL=http://localhost:3000

# Default credentials prefilled when provisioning a new Dockploy instance.
# The username must be an email address and also becomes the initial Dockploy
# administrator email. The password is also used for root SSH provisioning.
infra_services_default_username=admin@example.com
infra_services_default_password=replace-with-a-strong-password

# Optional one-time migration for an existing deployment. When the database is
# empty, these values are imported as a configured instance. Remove them after
# confirming the import. The instance must still be selected in the dashboard.
# DOKPLOY_NAME=Production
# DOKPLOY_URL=https://dokploy.example.com
# DOKPLOY_API_KEY=your-generated-api-key
