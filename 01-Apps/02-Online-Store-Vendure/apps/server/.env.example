# Server environment variables for Vendure
# Copy this file to .env and replace the placeholder values.

PORT=3000
COOKIE_SECRET=replace-with-a-secure-random-string
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=change-me-securely

# Either provide a full Postgres connection string or the individual values below.
# Examples:
# DB_HOST=postgres://user:password@hostname:5432/database
# DB_HOST=postgresql://user:password@hostname:5432/database
DB_HOST=postgresql://postgres:password@localhost:5432/postgres
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=password
DB_SCHEMA=public

# Either provide a Redis URL or just the host/port separately.
# The server currently reads REDIS_HOST directly.
REDIS_HOST=redis://default:password@localhost:6379
REDIS_PASSWORD=password

VENDURE_HOST=vendure.example.com

# Local development override flag
APP_ENV=local
